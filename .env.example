NEXT_PUBLIC_API_BASE_URL=

# Loads invented pilot-demo brands/products/evidence/retailers/reports into
# the mock stores at module init (src/lib/mock/seedData.ts) — see that file
# for exactly what's seeded. Defaults to on when unset. Set to "false" to
# run with empty stores.
NEXT_PUBLIC_SEED_DEMO_DATA=

# TEMPORARY PRE-AUTH GATE — NOT AUTHENTICATION. Gates /admin/* pages and the
# admin-only brand/retailer status PATCH routes behind a single shared
# secret (see proxy.ts at the project root for the full explanation and its
# real limits). Server-side only — deliberately NOT NEXT_PUBLIC_, since that
# prefix ships a variable's value to the browser bundle.
#
# If this is unset, /admin is denied to everyone, including in production
# — it fails closed, never open. Set it to any long random string; there's
# no format requirement. Never commit the real value — this file only
# documents the variable, .env.local and Vercel's dashboard hold the actual
# secret and neither is committed.
ADMIN_ACCESS_SECRET=